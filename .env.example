# Required: get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional overrides (see config.yaml for everything else)
# JARVIS_MODEL=claude-opus-5-5
# Telegram bot token from @BotFather (optional)
# TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to Jarvis
# TELEGRAM_ALLOWED_USERS=
# Token the phone/web app must send (generated by `jarvis setup`)
# JARVIS_WEB_TOKEN=
